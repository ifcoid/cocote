# cocote configuration — copy to .env and fill in.
# Real environment variables always take precedence over this file.

# Required: your Telegram bot token from @BotFather.
COCOTE_BOT_TOKEN=123456789:AA-your-bot-token-here

# Required: the numeric chat id cocote talks to (your user id, a group, or a
# channel). Get it by messaging your bot then visiting:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
COCOTE_CHAT_ID=123456789

# Optional: a label identifying this Claude Code session in Telegram messages.
# Defaults to "<hostname>-<pid>".
# COCOTE_SESSION_NAME=my-project

# Optional: how long a booking lease survives without a heartbeat before
# another session may take it over. Accepts "30s", "2m", or bare seconds.
# COCOTE_LEASE_TTL=30s

# Optional: long-poll timeout for Telegram getUpdates.
# COCOTE_POLL_TIMEOUT=30s

# Optional: directory holding the shared booking lock. Defaults to
# <user-config-dir>/cocote (so all sessions on this machine coordinate).
# COCOTE_LEASE_DIR=

# Optional: explicit path to an env file to load.
# COCOTE_ENV_FILE=
